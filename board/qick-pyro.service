[Unit]
Description=QICK Pyro4 server for qick-interface
Wants=network-online.target
After=network-online.target
# a permanent failure (missing bitfile, version mismatch) stops after 5 tries
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=idle
Restart=on-failure
RestartSec=10
User=root
# install.sh replaces @DIR@ with the folder holding qick_service.py
ExecStart=/bin/bash -c 'source /etc/profile && python @DIR@/qick_service.py'

[Install]
WantedBy=multi-user.target
